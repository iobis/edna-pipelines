manifest {
    name = 'edna-platform-pipelines'
    description = 'Prototype eDNA pipeline: nf-core/ampliseq + Darwin Core output'
    version = '0.1.0'
}

params {
    outdir = 'results'
    ampliseq_repo = 'https://github.com/nf-core/ampliseq.git'
    ampliseq_ref = 'dev'
    ampliseq_update = false
    sequencing_type = 'illumina_pe'
    clean_prefix = false
    ignore_binned_quality = false
}

profiles {
    standard {
        process.executor = 'local'
    }

    // Nested AmpliSeq uses Docker; SUMMARY_REPORT uses a locally ensured report image.
    // WoRMS / Darwin Core still use host Python (pipeline .venv).
    docker {
        process.executor = 'local'
        params.ampliseq_profile = 'docker'
        docker.enabled = true
    }
}
